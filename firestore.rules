rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isAllowedModel(modelId) {
      return modelId in ['gemini-3.8-flash', 'gemini-3.5-flash-lite', 'gemini-4-argon'];
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    // --- ENTITY VALIDATION HELPERS ---
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             isOptionalString(data, 'email', 200) &&
             isOptionalString(data, 'photoUrl', 500) &&
             data.preferredModel is string && isAllowedModel(data.preferredModel) &&
             data.themeMode is string && data.themeMode in ['system', 'dark', 'light'] &&
             data.memoryPermissionGranted is bool &&
             data.autoSpeakResponses is bool &&
             data.wakeWordEnabled is bool &&
             data.speechRate is number && data.speechRate >= 0.5 && data.speechRate <= 2.0 &&
             isOptionalString(data, 'selectedVoiceName', 120) &&
             isOptionalString(data, 'systemInstructions', 2000) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidConversation(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.modelId is string && isAllowedModel(data.modelId) &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 10000 &&
             data.pinned is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChatMessage(data, userId, conversationId) {
      return data.userId is string && data.userId == userId &&
             data.conversationId is string && data.conversationId == conversationId &&
             data.role is string && data.role in ['user', 'model'] &&
             data.text is string && data.text.size() <= 50000 &&
             data.attachmentType is string && data.attachmentType in ['none', 'image', 'pdf', 'document'] &&
             isOptionalString(data, 'attachmentName', 255) &&
             isOptionalString(data, 'generatedImageFile', 255) &&
             isOptionalString(data, 'modelUsed', 80) &&
             data.isError is bool &&
             data.clientOrder is int && data.clientOrder >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMemoryEntry(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.category is string && data.category in ['preference', 'fact', 'project', 'context'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
             isOptionalString(data, 'sourceConversationId', 128) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTION RULES ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'preferredModel', 'themeMode',
                         'memoryPermissionGranted', 'autoSpeakResponses', 'wakeWordEnabled',
                         'speechRate', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'photoUrl', 'preferredModel', 'themeMode',
                         'memoryPermissionGranted', 'autoSpeakResponses', 'wakeWordEnabled',
                         'speechRate', 'selectedVoiceName', 'systemInstructions', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'photoUrl', 'preferredModel', 'themeMode',
                         'memoryPermissionGranted', 'autoSpeakResponses', 'wakeWordEnabled',
                         'speechRate', 'selectedVoiceName', 'systemInstructions', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(conversationId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'modelId', 'lastMessagePreview',
                           'messageCount', 'pinned', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'modelId', 'lastMessagePreview',
                           'messageCount', 'pinned', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidConversation(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidConversation(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'modelId', 'lastMessagePreview', 'messageCount', 'pinned', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(conversationId);

        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(conversationId);

          allow create: if isOwner(userId) &&
                           isValidId(conversationId) &&
                           isValidId(messageId) &&
                           incoming().keys().hasAll([
                             'userId', 'conversationId', 'role', 'text',
                             'attachmentType', 'isError', 'clientOrder', 'createdAt', 'updatedAt'
                           ]) &&
                           incoming().keys().hasOnly([
                             'userId', 'conversationId', 'role', 'text',
                             'attachmentType', 'attachmentName', 'generatedImageFile',
                             'modelUsed', 'isError', 'clientOrder', 'createdAt', 'updatedAt'
                           ]) &&
                           isValidChatMessage(incoming(), userId, conversationId) &&
                           existsAfter(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId));

          allow update: if isOwner(userId) &&
                           isValidId(conversationId) &&
                           isValidId(messageId) &&
                           isValidChatMessage(incoming(), userId, conversationId) &&
                           incoming().userId == existing().userId &&
                           incoming().conversationId == existing().conversationId &&
                           incoming().role == existing().role &&
                           incoming().clientOrder == existing().clientOrder &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'text', 'attachmentType', 'attachmentName', 'generatedImageFile',
                             'modelUsed', 'isError', 'updatedAt'
                           ]);

          allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }

      match /memories/{memoryId} {
        allow get: if isOwner(userId) && isValidId(memoryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         incoming().keys().hasAll([
                           'userId', 'category', 'content', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'category', 'content', 'sourceConversationId', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMemoryEntry(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         isValidMemoryEntry(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'category', 'content', 'sourceConversationId', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(memoryId);
      }
    }
  }
}
